{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "VilaHub para WooCommerce",
    "author": "VilaHub",
    "description": "Instala WooCommerce e o plugin oficial VilaHub em uma demonstração temporária do WordPress Playground."
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/wp-admin/admin.php?page=vilahub",
  "steps": [
    {
      "step": "login",
      "username": "admin"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "vilahub-for-woocommerce"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
